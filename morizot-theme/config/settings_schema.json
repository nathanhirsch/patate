[
  {
    "name": "theme_info",
    "theme_name": "Morizot Passage",
    "theme_version": "1.0.0",
    "theme_author": "Morizot Passage",
    "theme_documentation_url": "https://github.com/nathanhirsch/patate",
    "theme_support_url": "https://github.com/nathanhirsch/patate/issues"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Show breadcrumbs on utility pages",
        "default": true
      }
    ]
  },
  {
    "name": "Reservations",
    "settings": [
      {
        "type": "paragraph",
        "content": "Reserve mode replaces every add-to-cart with a no-payment pre-order form and hides the cart. Flip to Buy once a payment provider is live."
      },
      {
        "type": "select",
        "id": "store_mode",
        "label": "Store mode",
        "default": "buy",
        "options": [
          { "value": "buy", "label": "Buy (checkout)" },
          { "value": "reserve", "label": "Reserve (pre-order form, no payment)" }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_price_in_reserve_mode",
        "label": "Show price in reserve mode",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_notes_enabled",
        "label": "Enable order notes",
        "default": true
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_email", "label": "Contact email" }
    ]
  }
]
