{% layout 'password' %}
<div class="mp">
  <div class="mp-wrap mp-page">
    <div class="mp-center">
      <p class="mp-mono mp-mono--accent">{{ shop.name }}</p>
      <h1 class="mp-page__title">Opening soon</h1>
      {%- if shop.password_message != blank -%}
        <div class="mp-prose">{{ shop.password_message }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'mp-center', style: 'width:100%' -%}
        {%- if form.posted_successfully? -%}
          <p class="mp-form-note">{{ 'general.newsletter_form.confirmation' | t }}</p>
        {%- else -%}
          <label class="mp-field" style="width:100%">
            <span>{{ 'general.newsletter_form.email_placeholder' | t }}</span>
            <input type="email" name="contact[email]" required>
          </label>
          <input type="hidden" name="contact[tags]" value="prospect, password page">
          <button type="submit" class="mp-link-btn" style="margin-top:14px">Notify me</button>
        {%- endif -%}
      {%- endform -%}

      <details style="margin-top:24px">
        <summary class="mp-mono mp-mono--dim" style="cursor:pointer">Enter using password</summary>
        {%- form 'storefront_password', class: 'mp-center', style: 'width:100%;margin-top:14px' -%}
          {%- if form.errors -%}
            <div class="mp-form-err">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <label class="mp-field" style="width:100%"><span>Password</span><input type="password" name="password" required></label>
          <button type="submit" class="mp-link-btn mp-link-btn--ghost" style="margin-top:14px">Enter</button>
        {%- endform -%}
      </details>
    </div>
  </div>
</div>
