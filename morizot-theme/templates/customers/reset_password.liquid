<div class="mp">
  <div class="mp-wrap mp-page">
    <div class="mp-center">
      <p class="mp-mono mp-mono--accent">Account</p>
      <h1 class="mp-page__title">{{ 'customer.reset_password.title' | t }}</h1>
      {%- form 'reset_customer_password', class: 'mp-center', style: 'width:100%' -%}
        {%- if form.errors -%}<div class="mp-form-err">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="mp-field" style="width:100%"><span>{{ 'customer.reset_password.password' | t }}</span><input type="password" name="customer[password]" required></label>
        <label class="mp-field" style="width:100%"><span>{{ 'customer.reset_password.password_confirm' | t }}</span><input type="password" name="customer[password_confirmation]" required></label>
        <button type="submit" class="mp-link-btn" style="margin-top:14px">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>
