    "fuel": {
      "type": "mp-fuel",
      "blocks": {
        "r1": {
          "type": "reason",
          "settings": {
            "title": "Carbohydrate that lasts",
            "text": "Mostly complex starch, so it releases over hours instead of spiking and dropping. 40 g a serving — a real ride's worth, not a gel's."
          }
        },
        "r2": {
          "type": "reason",
          "settings": {
            "title": "Potassium and magnesium",
            "text": "The two minerals you lose fastest in sweat, and the ones cramping legs ask for. A sweet potato has more potassium than a banana."
          }
        },
        "r3": {
          "type": "reason",
          "settings": {
            "title": "Beta-carotene",
            "text": "The orange is vitamin A. It is the one nutrient in this cake that has nothing to do with performance and everything to do with eating well."
          }
        },
        "r4": {
          "type": "reason",
          "settings": {
            "title": "Easy at effort",
            "text": "No grain, no gluten, no dairy. Cooked starch and eggs, which is about the gentlest thing you can ask a stomach to handle at mile 20."
          }
        }
      },
