{% comment %}
  mp-stats — the three-cell claim band under the hero / gallery.
  Values come from section settings so the merchant can restate macros
  without a code edit.
{% endcomment %}
<div class="mp-stats">
  <div class="mp-stat"><div class="mp-stat__v">{{ stat_1_value }}</div><div class="mp-stat__l mp-mono mp-mono--dim">{{ stat_1_label | escape }}</div></div>
  <div class="mp-stat"><div class="mp-stat__v">{{ stat_2_value }}</div><div class="mp-stat__l mp-mono mp-mono--dim">{{ stat_2_label | escape }}</div></div>
  <div class="mp-stat"><div class="mp-stat__v"><em>{{ stat_3_value }}</em></div><div class="mp-stat__l mp-mono mp-mono--dim">{{ stat_3_label | escape }}</div></div>
</div>
