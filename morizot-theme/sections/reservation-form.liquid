{% comment %}
  MP Reservation — a standalone no-payment pre-order form for any template
  (e.g. a dedicated /pages/pre-order page). On the product page the same form
  is rendered by the mp-product "Reservation form" block instead.

  Renders nothing when Enabled is off.
{% endcomment %}
{% render 'mp-assets' %}
{%- assign s = section.settings -%}
{%- if s.enabled -%}
  {%- assign pt = s.product.title | default: shop.name -%}
  <div class="mp">
    <section class="mp-wrap mp-flow" aria-label="{{ s.heading | default: s.button_label | default: 'Pre-order' | escape }}">
      <div class="mp-reserve__wrap mp-reveal">
        {% render 'mp-reservation',
           uid: section.id,
           product_title: pt,
           heading: s.heading,
           subheading: s.subheading,
           button_label: s.button_label,
           disclaimer: s.disclaimer,
           success_message: s.success_message,
           ca_only_message: s.ca_only_message,
           max_boxes: s.max_boxes,
           cakes_per_box: s.cakes_per_box %}
      </div>
    </section>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "MP Reservation",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enabled", "default": true },
    { "type": "paragraph", "content": "A no-payment form. Submissions arrive as email to the store's sender address (Settings → Notifications). California delivery only." },
    { "type": "product", "id": "product", "label": "Product (optional — names the item in the email)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pre-order" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Leave your details and we'll email a checkout link when the first batch is ready." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Pre-order" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "No payment now. California delivery only." },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "Reserved. No payment taken. We'll email you a checkout link when the first batch is ready." },
    { "type": "text", "id": "ca_only_message", "label": "Out-of-California message", "default": "We can only ship within California right now." },
    { "type": "number", "id": "max_boxes", "label": "Maximum boxes per reservation", "default": 20 },
    { "type": "number", "id": "cakes_per_box", "label": "Cakes per box (helper text)", "default": 6 }
  ],
  "presets": [{ "name": "MP Reservation" }]
}
{% endschema %}
